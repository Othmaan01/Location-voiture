# ---------------------------------------------------------------------
# Variables d'environnement — copier vers .env.local (jamais versionne)
# Chaque application lit uniquement ce dont elle a besoin (voir apps/*/src/env.ts).
# ---------------------------------------------------------------------

# Supabase (local : valeurs affichees par `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres direct (API, migrations, tests d'integration)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
# Emetteur attendu des JWT Supabase : <SUPABASE_URL>/auth/v1
API_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000
# Schema de lien profond de l app mobile (invitations)
APP_DEEP_LINK_SCHEME=lv

# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mobile (Expo) — prefixe EXPO_PUBLIC_ = embarque dans le bundle, donc public par nature
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Billing (abonnement loueur) — Phase 5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail transactionnel (Resend) — utilise aussi comme SMTP par Supabase Auth
RESEND_API_KEY=

# Jeton d acces personnel Supabase (Account -> Access Tokens) : configuration du projet depuis la machine
SUPABASE_ACCESS_TOKEN=

# Secret JWT du projet Supabase (Settings > API > JWT Secret) : verification des jetons cote API.
SUPABASE_JWT_SECRET=
# Expediteur des e-mails (Resend) : « Location Voiture <onboarding@resend.dev> » tant que le domaine n'est pas verifie.
EMAIL_FROM=
# « true » en production : la double authentification est exigee pour les routes d'administration.
API_ADMIN_REQUIRE_MFA=
# Version affichee par /health (posee par le deploiement).
API_VERSION=
# development | test | production
NODE_ENV=
